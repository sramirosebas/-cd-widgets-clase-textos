<!DOCTYPE html>
<html lang="es">  
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Language Model — Loop de Generación</title>
<link href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:      #0a0a0a;
    --surface: #111111;
    --border:  #222222;
    --text:    #e0dbd4;
    --dim:     #444;
    --dim2:    #666;
    --prompt-col: #f0c060;
    --gen-col:    #60c0a0;
    --state-col:  #8080ff;
    --pred-col:   #ff6060;
    --win-col:    #60ff90;
    --shape-col:  #aaa;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'IBM Plex Mono', monospace;
    min-height: 100vh;
    padding: 1.5rem;
    max-width: 980px;
    margin: 0 auto;
  }

  /* HEADER */
  .header { margin-bottom: 1.5rem; }
  .header-tag {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--dim2);
    margin-bottom: 0.3rem;
  }
  .header-title { font-size: 1.2rem; font-weight: 600; color: var(--text); margin-bottom: 0.3rem; }
  .header-sub { font-size: 0.78rem; color: var(--dim2); line-height: 1.5; }

  /* MAIN LAYOUT */
  .main { display: grid; grid-template-columns: 1fr 320px; gap: 1rem; margin-bottom: 1rem; }
  @media (max-width: 700px) { .main { grid-template-columns: 1fr; } }

  /* PANEL BASE */
  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1rem;
  }
  .panel-label {
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim2);
    margin-bottom: 0.7rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .shape-badge {
    font-size: 0.6rem;
    color: var(--shape-col);
    background: #1a1a1a;
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.15rem 0.4rem;
    letter-spacing: 0.04em;
  }

  /* TEXT OUTPUT */
  .text-output {
    font-family: 'Courier Prime', monospace;
    font-size: 1rem;
    line-height: 1.7;
    min-height: 60px;
    word-break: break-all;
  }
  .text-prompt { color: var(--prompt-col); }
  .text-gen    { color: var(--gen-col); }
  .text-cursor {
    display: inline-block;
    width: 9px; height: 1.1em;
    background: var(--gen-col);
    vertical-align: middle;
    animation: blink 1s step-end infinite;
    margin-left: 1px;
  }
  @keyframes blink { 50% { opacity: 0; } }

  /* STEP DIAGRAM */
  .step-diagram {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .step-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .step-box {
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0.5rem 0.7rem;
    flex: 1;
    transition: border-color 0.3s, background 0.3s;
  }
  .step-box.active {
    border-color: currentColor;
    background: rgba(255,255,255,0.03);
  }
  .step-box-label {
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.3rem;
    opacity: 0.6;
  }
  .step-box-val {
    font-size: 0.82rem;
    font-weight: 600;
  }
  .step-box-shape {
    font-size: 0.58rem;
    color: var(--shape-col);
    margin-top: 0.2rem;
  }

  .step-arrow {
    color: var(--dim2);
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  /* color themes per step */
  .s-input  { color: var(--prompt-col); }
  .s-state  { color: var(--state-col); }
  .s-pred   { color: var(--pred-col); }
  .s-winner { color: var(--win-col); }
  .s-gen    { color: var(--gen-col); }

  /* STATE VECTOR */
  .state-viz {
    display: flex;
    gap: 1px;
    height: 32px;
    align-items: flex-end;
    margin-top: 0.4rem;
  }
  .state-bar {
    flex: 1;
    background: var(--state-col);
    opacity: 0.6;
    border-radius: 1px 1px 0 0;
    transition: height 0.4s ease;
    min-height: 2px;
  }

  /* PROB DISTRIBUTION */
  .prob-panel { }
  .prob-bars {
    display: flex;
    gap: 1px;
    align-items: flex-end;
    height: 80px;
    margin-top: 0.5rem;
    margin-bottom: 0.4rem;
  }
  .prob-bar-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    justify-content: flex-end;
    position: relative;
  }
  .prob-bar {
    width: 100%;
    background: var(--pred-col);
    opacity: 0.5;
    border-radius: 1px 1px 0 0;
    transition: height 0.35s ease, opacity 0.35s;
    min-height: 1px;
  }
  .prob-bar.winner {
    background: var(--win-col);
    opacity: 1;
  }
  .prob-char-label {
    font-size: 0.55rem;
    color: var(--dim2);
    margin-top: 2px;
    text-align: center;
    overflow: hidden;
    white-space: nowrap;
  }
  .prob-char-label.winner { color: var(--win-col); font-weight: 600; }

  .winner-announce {
    font-size: 0.78rem;
    padding: 0.4rem 0.6rem;
    background: rgba(96,255,144,0.07);
    border: 1px solid rgba(96,255,144,0.2);
    border-radius: 4px;
    color: var(--win-col);
    text-align: center;
    margin-top: 0.5rem;
    min-height: 2rem;
  }

  /* CONTROLS */
  .controls {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .btn {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.72rem;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 0.45rem 0.9rem;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .btn:hover { background: #1a1a1a; border-color: #444; }
  .btn.primary {
    border-color: var(--gen-col);
    color: var(--gen-col);
  }
  .btn.primary:hover { background: rgba(96,192,160,0.08); }
  .btn:disabled { opacity: 0.35; cursor: not-allowed; }

  .step-counter {
    font-size: 0.7rem;
    color: var(--dim2);
    margin-left: auto;
  }

  /* PHASE INDICATOR */
  .phase-indicator {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .phase-pill {
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    border: 1px solid var(--border);
    color: var(--dim2);
    transition: all 0.25s;
  }
  .phase-pill.active-phase {
    border-color: currentColor;
    font-weight: 600;
  }
  .ph-prompt { color: var(--prompt-col); }
  .ph-gen    { color: var(--gen-col); }

  /* NOTE */
  .note {
    font-size: 0.7rem;
    color: var(--dim2);
    border-left: 2px solid var(--border);
    padding-left: 0.7rem;
    line-height: 1.5;
    margin-top: 0.5rem;
  }
  .note span { color: var(--dim); }
</style>
</head>
<body>

<div class="header">
  <div class="header-tag">Listings 15.6 — 15.8</div>
  <div class="header-title">Loop de generación autoregresivo</div>
  <div class="header-sub">Paso a paso: cómo el modelo genera un caracter a la vez usando su propio output como input.</div>
</div>

<!-- PHASE -->
<div class="phase-indicator">
  <div class="phase-pill ph-prompt" id="pill-prompt">fase 1 — procesar prompt</div>
  <div class="phase-pill ph-gen" id="pill-gen">fase 2 — generación</div>
</div>

<div class="main">

  <!-- LEFT: step diagram + text -->
  <div style="display:flex;flex-direction:column;gap:1rem;">

    <div class="panel">
      <div class="panel-label">Texto generado</div>
      <div class="text-output" id="text-output">
        <span class="text-prompt" id="text-prompt"></span><span class="text-gen" id="text-gen"></span><span class="text-cursor" id="cursor"></span>
      </div>
    </div>

    <div class="panel">
      <div class="panel-label">Paso actual — flujo de datos</div>
      <div class="step-diagram">

        <!-- Input token -->
        <div class="step-row">
          <div class="step-box s-input" id="box-input">
            <div class="step-box-label">input token</div>
            <div class="step-box-val" id="val-input">—</div>
            <div class="step-box-shape">shape: (1, 1) — 1 char, batch=1</div>
          </div>
        </div>

        <div class="step-row" style="justify-content:center">
          <div class="step-arrow">↓ Embedding (67×256) ↓</div>
        </div>

        <!-- Embedding -->
        <div class="step-row">
          <div class="step-box s-input" id="box-emb">
            <div class="step-box-label">embedding del caracter</div>
            <div class="step-box-val" id="val-emb">—</div>
            <div class="step-box-shape">shape: (1, 1, 256)</div>
          </div>
        </div>

        <div class="step-row" style="justify-content:center">
          <div class="step-arrow">↓ + estado anterior ↓</div>
        </div>

        <!-- GRU -->
        <div class="step-row" style="gap:0.5rem">
          <div class="step-box s-state" id="box-state-in" style="flex:1">
            <div class="step-box-label">estado anterior h(t-1)</div>
            <div class="step-box-val" id="val-state-in">zeros</div>
            <div class="step-box-shape">shape: (1, 1024)</div>
            <div class="state-viz" id="state-viz-in"></div>
          </div>
          <div style="color:var(--dim2);font-size:0.8rem;align-self:center">→GRU→</div>
          <div class="step-box s-state" id="box-state-out" style="flex:1">
            <div class="step-box-label">estado nuevo h(t)</div>
            <div class="step-box-val" id="val-state-out">—</div>
            <div class="step-box-shape">shape: (1, 1024)</div>
            <div class="state-viz" id="state-viz-out"></div>
          </div>
        </div>

        <div class="step-row" style="justify-content:center">
          <div class="step-arrow">↓ Dense (1024→67) + softmax ↓</div>
        </div>

        <!-- Predictions -->
        <div class="step-row">
          <div class="step-box s-pred" id="box-pred">
            <div class="step-box-label">predicciones (prob. sobre vocabulario)</div>
            <div class="step-box-val" id="val-pred">—</div>
            <div class="step-box-shape">shape: (1, 1, 67) — suma = 1.0</div>
          </div>
        </div>

        <div class="step-row" style="justify-content:center">
          <div class="step-arrow">↓ argmax ↓</div>
        </div>

        <!-- Winner -->
        <div class="step-row">
          <div class="step-box s-winner" id="box-winner">
            <div class="step-box-label">caracter elegido (argmax)</div>
            <div class="step-box-val" id="val-winner">—</div>
            <div class="step-box-shape">→ se agrega al texto y vuelve como input</div>
          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- RIGHT: prob distribution + controls -->
  <div style="display:flex;flex-direction:column;gap:1rem;">

    <div class="panel prob-panel">
      <div class="panel-label">
        Distribución de probabilidad
        <span class="shape-badge">(1, 1, 67)</span>
      </div>
      <div class="prob-bars" id="prob-bars"></div>
      <div class="winner-announce" id="winner-announce">—</div>
      <div class="note" style="margin-top:0.8rem">
        <span>nota:</span> probabilidades ilustrativas. El patrón real depende del modelo entrenado. La mecánica del loop es idéntica.
      </div>
    </div>

    <div class="panel">
      <div class="panel-label">Controles</div>
      <div class="controls">
        <button class="btn primary" id="btn-step" onclick="step()">Siguiente paso →</button>
        <button class="btn" id="btn-auto" onclick="toggleAuto()">Auto</button>
        <button class="btn" onclick="reset()">Reset</button>
      </div>
      <div class="step-counter" id="step-counter" style="margin-top:0.7rem">paso 0 / 0</div>
    </div>

  </div>
</div>

<script>
// ---- DATA ----
const PROMPT = "KING RICHARD III:";

// Simulated vocabulary (top chars from Shakespeare)
const VOCAB = [
  ' ','e','t','o','a','i','n','s','h','r',
  'l','d','u','m','c','w','f','g','y','p',
  'b','v','k','T','A','S','W','H','I','O',
  '\n','.',',',':',';','?','!','-',"'",'E',
  'N','R','L','C','B','D','M','F','P','G',
  'Y','K','U','J','V','Q','X','Z','0','1',
  '2','3','4','5','6','7','8'
];

// Simulated generation after the prompt
const GEN_SEQUENCE = [
  '\n','I',' ','a','m',' ','n','o','t',' ',
  's','h','a','p','e','d',' ','f','o','r',
  '\n','s','p','o','r','t','i','v','e',' ','t'
];

// Simulated probability distributions for each gen step
function makeDist(winnerIdx, seed) {
  const d = new Array(VOCAB.length).fill(0);
  // give winner ~35-50% prob, distribute rest
  let sum = 0;
  for (let i = 0; i < d.length; i++) {
    d[i] = Math.abs(Math.sin(seed * 37 + i * 13)) * 0.04;
    sum += d[i];
  }
  const winnerProb = 0.35 + Math.abs(Math.sin(seed * 7)) * 0.15;
  const scale = (1 - winnerProb) / sum;
  for (let i = 0; i < d.length; i++) d[i] *= scale;
  d[winnerIdx] = winnerProb;
  return d;
}

// Simulated state vectors (just random-ish for visualization)
function makeState(seed) {
  return Array.from({length: 40}, (_, i) =>
    Math.abs(Math.sin(seed * 17 + i * 7))
  );
}

// ---- STATE ----
let stepIndex = 0;
let phase = 'prompt'; // 'prompt' | 'gen'
let promptStep = 0;
let genStep = 0;
let generatedText = '';
let currentState = makeState(0);
let autoInterval = null;

const totalSteps = PROMPT.length + GEN_SEQUENCE.length;

// ---- DOM ----
const textPromptEl  = document.getElementById('text-prompt');
const textGenEl     = document.getElementById('text-gen');
const cursorEl      = document.getElementById('cursor');
const valInput      = document.getElementById('val-input');
const valEmb        = document.getElementById('val-emb');
const valStateIn    = document.getElementById('val-state-in');
const valStateOut   = document.getElementById('val-state-out');
const valPred       = document.getElementById('val-pred');
const valWinner     = document.getElementById('val-winner');
const stateVizIn    = document.getElementById('state-viz-in');
const stateVizOut   = document.getElementById('state-viz-out');
const probBarsEl    = document.getElementById('prob-bars');
const winnerAnn     = document.getElementById('winner-announce');
const stepCounter   = document.getElementById('step-counter');
const pillPrompt    = document.getElementById('pill-prompt');
const pillGen       = document.getElementById('pill-gen');
const btnStep       = document.getElementById('btn-step');

function dispChar(c) {
  if (c === '\n') return '\\n';
  if (c === ' ')  return 'SPACE';
  return `'${c}'`;
}

function renderStateViz(el, stateArr) {
  el.innerHTML = stateArr.map(v =>
    `<div class="state-bar" style="height:${Math.round(v*100)}%"></div>`
  ).join('');
}

function renderProbs(dist, winnerIdx) {
  // show only top 20 for readability
  const indexed = dist.map((p,i) => ({p, i}))
    .sort((a,b) => b.p - a.p)
    .slice(0, 20);
  const maxP = indexed[0].p;

  probBarsEl.innerHTML = indexed.map(({p, i}) => {
    const h = Math.round((p / maxP) * 100);
    const isW = i === winnerIdx;
    const label = VOCAB[i] === '\n' ? '↵' : (VOCAB[i] === ' ' ? '·' : VOCAB[i]);
    return `<div class="prob-bar-wrap">
      <div class="prob-bar${isW ? ' winner' : ''}" style="height:${h}%"></div>
      <div class="prob-char-label${isW ? ' winner' : ''}">${label}</div>
    </div>`;
  }).join('');
}

function updatePhase() {
  pillPrompt.classList.toggle('active-phase', phase === 'prompt');
  pillGen.classList.toggle('active-phase', phase === 'gen');
}

function step() {
  if (stepIndex >= totalSteps) return;

  const prevState = [...currentState];
  const newState  = makeState(stepIndex + 1);
  currentState    = newState;

  if (stepIndex < PROMPT.length) {
    // PROMPT PHASE
    phase = 'prompt';
    const char = PROMPT[stepIndex];
    textPromptEl.textContent = PROMPT.slice(0, stepIndex + 1);

    const embIdx = VOCAB.indexOf(char) !== -1 ? VOCAB.indexOf(char) : 0;
    valInput.textContent   = dispChar(char) + ` → id ${embIdx}`;
    valEmb.textContent     = `vector de 256 nums para '${char === '\n' ? '\\n' : char}'`;
    valStateIn.textContent = stepIndex === 0 ? 'zeros (inicio)' : 'h del paso anterior';
    valStateOut.textContent= 'h actualizado';
    valPred.textContent    = 'prob. calculadas (descartadas en esta fase)';
    valWinner.textContent  = '— (en fase prompt no se genera)';
    winnerAnn.textContent  = 'Fase prompt: el modelo lee el contexto, no genera todavía.';
    winnerAnn.style.color  = 'var(--prompt-col)';
    winnerAnn.style.borderColor = 'rgba(240,192,96,0.3)';
    winnerAnn.style.background  = 'rgba(240,192,96,0.05)';

    const promptDist = makeDist(embIdx, stepIndex);
    renderProbs(promptDist, embIdx);

  } else {
    // GENERATION PHASE
    phase = 'gen';
    const gi = stepIndex - PROMPT.length;
    const char = GEN_SEQUENCE[gi];
    const charIdx = VOCAB.indexOf(char) !== -1 ? VOCAB.indexOf(char) : 0;

    generatedText = GEN_SEQUENCE.slice(0, gi + 1).join('');
    textGenEl.textContent = generatedText;

    const dist = makeDist(charIdx, stepIndex);
    const topProb = (dist[charIdx] * 100).toFixed(1);

    const prevChar = gi === 0 ? PROMPT[PROMPT.length - 1] : GEN_SEQUENCE[gi - 1];
    valInput.textContent   = dispChar(prevChar) + ' (output anterior)';
    valEmb.textContent     = `vector de 256 nums para '${prevChar === '\n' ? '\\n' : prevChar}'`;
    valStateIn.textContent = 'h del paso anterior';
    valStateOut.textContent= 'h actualizado → se guarda para el próximo paso';
    valPred.textContent    = `${topProb}% para '${char === '\n' ? '\\n' : char}' (mayor prob)`;
    valWinner.textContent  = dispChar(char) + ' → se agrega al texto';
    winnerAnn.innerHTML    = `argmax → <strong>${char === '\n' ? '↵' : char}</strong> &nbsp; (prob: ${topProb}%) → vuelve como input`;
    winnerAnn.style.color  = 'var(--win-col)';
    winnerAnn.style.borderColor = 'rgba(96,255,144,0.2)';
    winnerAnn.style.background  = 'rgba(96,255,144,0.05)';

    renderProbs(dist, charIdx);
  }

  renderStateViz(stateVizIn,  prevState);
  renderStateViz(stateVizOut, newState);
  updatePhase();

  stepIndex++;
  stepCounter.textContent = `paso ${stepIndex} / ${totalSteps}`;

  if (stepIndex >= totalSteps) {
    btnStep.disabled = true;
    stopAuto();
    cursorEl.style.display = 'none';
  }
}

function reset() {
  stopAuto();
  stepIndex     = 0;
  phase         = 'prompt';
  generatedText = '';
  currentState  = makeState(0);

  textPromptEl.textContent = '';
  textGenEl.textContent    = '';
  cursorEl.style.display   = 'inline-block';
  valInput.textContent     = '—';
  valEmb.textContent       = '—';
  valStateIn.textContent   = '—';
  valStateOut.textContent  = '—';
  valPred.textContent      = '—';
  valWinner.textContent    = '—';
  winnerAnn.textContent    = '—';
  winnerAnn.style.color    = 'var(--dim2)';
  winnerAnn.style.borderColor = 'var(--border)';
  winnerAnn.style.background  = 'transparent';
  probBarsEl.innerHTML     = '';
  stateVizIn.innerHTML     = '';
  stateVizOut.innerHTML    = '';
  stepCounter.textContent  = `paso 0 / ${totalSteps}`;
  btnStep.disabled         = false;

  pillPrompt.classList.remove('active-phase');
  pillGen.classList.remove('active-phase');
}

function toggleAuto() {
  if (autoInterval) { stopAuto(); return; }
  const btn = document.getElementById('btn-auto');
  btn.textContent = 'Pausar';
  btn.style.borderColor = 'var(--pred-col)';
  btn.style.color = 'var(--pred-col)';
  autoInterval = setInterval(() => {
    if (stepIndex >= totalSteps) { stopAuto(); return; }
    step();
  }, 700);
}

function stopAuto() {
  clearInterval(autoInterval);
  autoInterval = null;
  const btn = document.getElementById('btn-auto');
  btn.textContent = 'Auto';
  btn.style.borderColor = '';
  btn.style.color = '';
}

// init
stepCounter.textContent = `paso 0 / ${totalSteps}`;
</script>
</body>
</html>
